<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The Nexudus library itself uses no NuGet packages. The nuget.org source below
       exists only so package-dependent sample projects (e.g. BCPRecordNexusActivity,
       which uses Microsoft.Data.SqlClient) can be restored. The core library and the
       package-free samples still build fully offline. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
